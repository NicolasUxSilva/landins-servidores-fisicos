---
// Explicação curta da oferta e dos usos mais comuns.
import Icon from './Icon.astro';
import { APPLICATIONS } from '../data/content';

interface Props {
  number?: string;
}

const { number = '01' } = Astro.props;
---

<section class="section" id="aplicacoes" aria-labelledby="oferta-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow"><b>{number}</b> Para que serve</p>
        <h2 id="oferta-title">Um servidor físico só para os sistemas da sua empresa</h2>
      </div>
      <p>
        Processador, memória e discos ficam reservados para a sua operação, sem disputa com outros clientes. A MSSERVER vende e aluga servidores rack e torre e indica a configuração certa para cada uso.
      </p>
    </div>

    <ul class="oferta-grid">
      {
        APPLICATIONS.map((app, i) => (
          <li class="oferta-item" data-reveal style={`--reveal-i:${i % 5}`}>
            <span class="icon-tile">
              <Icon name={app.icon} />
            </span>
            <h3>{app.title}</h3>
            <p>{app.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .oferta-grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .oferta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .oferta-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .oferta-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .oferta-item h3 {
    margin-top: 0.35rem;
    font-size: 1.1rem;
  }

  .oferta-item p {
    color: var(--c-ink-2);
    font-size: 0.925rem;
  }

  @media (max-width: 639px) {
    .oferta-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.85rem;
      row-gap: 0.35rem;
      padding: 1.15rem;
    }

    .oferta-item .icon-tile {
      grid-row: span 2;
    }

    .oferta-item h3 {
      margin-top: 0.1rem;
    }
  }
</style>
