# Copie para .env.production (ou defina nas variáveis do projeto na Vercel).

# Container do Google Tag Manager usado em msserver.com.br. Sem esta variável,
# a página não carrega o GTM (os eventos ficam só no dataLayer local).
PUBLIC_GTM_ID=GTM-KTDRRP3

# "true" em ambientes de teste para impedir indexação (o canonical continua
# apontando para a URL oficial).
PUBLIC_NOINDEX=false

# Caminho de publicação (base dos assets). Ex.: /servidores-fisicos
BASE_PATH=/
